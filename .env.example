# Sao chép file này thành .env nếu muốn bật API live/AI.
# Không commit .env vì file đó chứa key thật.

# Dữ liệu portable mặc định đọc từ vn100_full.db trong thư mục dự án.
# Nếu chạy bằng Chay_Dinh_Gia_VN100.command, launcher sẽ tự set 2 biến này.
DATABASE_URL_READONLY=
DATABASE_URL_WRITE=

# vnstock: chỉ cần khi muốn cập nhật dữ liệu mới/live.
VNSTOCK_API_KEY=

# DeepSeek: chỉ dùng khi bấm nút sinh báo cáo AI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google/Discord: chỉ cần nếu dùng xuất Google Sheets/Drive hoặc cảnh báo Discord.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_MASTER_ID=
GOOGLE_DRIVE_FOLDER_ID=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# Bot chỉ nhận lệnh trong 1 kênh; để trống DISCORD_OWNER_ID = mọi thành viên kênh dùng được (Developer Mode → Copy ID).
DISCORD_OWNER_ID=
DISCORD_CHANNEL_ID=
RECOMPUTE_WEBHOOK_TOKEN=

# Tham số định giá có thể override trong môi trường.
ERP_VN=

# Mặc định dùng giá đã lưu trong DB portable để ai tải về cũng chạy được.
# Đổi thành 1 nếu máy có key/quyền API và muốn lấy giá live.
ENABLE_LIVE_PRICE=0

# n8n (scripts/activate_n8n.py, scripts/import_n8n.py)
N8N_BASE_URL=
N8N_API_KEY=
