{
  "name": "VN100 Daily Valuation Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 15 * * 1-5"
            }
          ]
        }
      },
      "name": "Schedule (15:30 Weekdays)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/orchestration/run-daily",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tickers",
              "value": "[\"VCB\", \"FPT\", \"VHM\", \"HPG\", \"VNM\", \"SSI\", \"GAS\", \"MSN\"]"
            }
          ]
        },
        "options": {}
      },
      "name": "Trigger Python Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "YOUR_DISCORD_ERROR_WEBHOOK_URL",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "🚨 CRITICAL: VN100 Daily Pipeline Failed! Please check Python backend logs."
            }
          ]
        }
      },
      "name": "Discord Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 500]
    }
  ],
  "connections": {
    "Schedule (15:30 Weekdays)": {
      "main": [
        [
          {
            "node": "Trigger Python Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Python Engine": {
      "main": [
        [
          {
            "node": "Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status": {
      "main": [
        [],
        [
          {
            "node": "Discord Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
